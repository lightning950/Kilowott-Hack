# Runtime environment: development, production, or test.
NODE_ENV=development
# HTTP port for the Express API.
PORT=4000
# Browser origin allowed by CORS.
CORS_ORIGIN=http://localhost:5173
# SQLite database path, relative to the repository root.
DATABASE_PATH=./data/pim.db
# Pino log level.
LOG_LEVEL=info

# Store adapter mode: mock for the built-in store, or real for WooCommerce.
WOO_MODE=mock
# Real WooCommerce base URL; required when WOO_MODE=real.
WOO_URL=https://your-store.example.com
# Real WooCommerce Read/Write consumer key; required when WOO_MODE=real.
WOO_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Real WooCommerce consumer secret; required when WOO_MODE=real.
WOO_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Store request timeout in milliseconds.
WOO_TIMEOUT_MS=15000
